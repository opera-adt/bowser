// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`map toolbars (Leaflet: everything supported) > renders the same buttons as before > left 1`] = `"<div class="map-toolbar"><button class="map-tool-btn" title="Measure distance (click points, double-click to finish)"><i class="fa-solid fa-ruler"></i></button><button class="map-tool-btn" title="Draw profile line (click start, click end, double-click to extract)"><i class="fa-solid fa-chart-area"></i></button><button class="map-tool-btn" title="Identify: what is under a click (GNSS stations, geology, soil, land cover, layers)"><i class="fa-solid fa-arrow-pointer"></i></button><button class="map-tool-btn active" title="Toggle spatial re-referencing"><i class="fa-solid fa-crosshairs"></i></button><button class="map-tool-btn" title="Point picking ON — click to disable"><i class="fa-solid fa-location-dot"></i></button></div>"`;

exports[`map toolbars (Leaflet: everything supported) > renders the same buttons as before > right 1`] = `"<div class="map-toolbar-right"><button class="map-tool-btn" title="Fit view to dataset"><i class="fa-solid fa-arrows-to-circle"></i></button><div style="position: relative;"><button class="map-tool-btn basemap-trigger" title="Basemap"><i class="fa-solid fa-map"></i></button></div><button class="map-tool-btn" title="Split screen — compare two layers"><i class="fa-solid fa-table-columns"></i></button><button class="map-tool-btn active" title="Toggle colorbar on map"><i class="fa-solid fa-palette"></i></button><button class="map-tool-btn" title="Toggle LOS geometry indicator"><i class="fa-solid fa-satellite"></i></button><button class="map-tool-btn" title="Lat/lon grid: off (click to cycle)"><i class="fa-solid fa-border-all"></i></button><button class="map-tool-btn" title="Toggle annotation mode"><i class="fa-solid fa-pen-to-square"></i></button><button class="map-tool-btn" title="Inspect pixel value on hover"><i class="fa-solid fa-eye-dropper"></i></button><button class="map-tool-btn" title="Hide toolbar" style="margin-top: 4px; opacity: 0.6;"><i class="fa-solid fa-chevron-right"></i></button></div>"`;
